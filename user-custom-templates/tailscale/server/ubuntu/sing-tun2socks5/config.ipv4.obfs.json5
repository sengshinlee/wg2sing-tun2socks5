{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": true,
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "Cloudflare-V4",
        "server": "1.1.1.1",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "type": "https",
        "tag": "Cloudflare-DoH",
        "domain_resolver": "Cloudflare-V4",
        "server": "cloudflare-dns.com"
      }
    ],
    "final": "Cloudflare-DoH",
    "strategy": "ipv4_only",
    "disable_cache": false,
    "disable_expire": false
  },
  "ntp": {
    "server": "ntp.ubuntu.com",
    "server_port": 0
  },
  "http_clients": [
    {
      "tag": "rule-set-direct-out",
      "engine": "go"
    }
  ],
  // Equivalent to "tailscale up --advertise-exit-node=true"
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "state_directory": "/etc/tailscale", // The directory where the Tailscale state is stored, default: tailscale
      "auth_key": "YOUR_TAILSCALE_AUTH_KEY", // The auth key to create the node
      "control_url": "", // The coordination server URL, default: https://controlplane.tailscale.com
      "ephemeral": false, // Indicates whether the instance should register as an Ephemeral node
      "hostname": "YOUR_UBUNTU_SERVER_MACHINE_HOSTNAME", // The hostname of the node
      "accept_routes": true, // Indicates whether the node should accept routes advertised by other nodes
      "exit_node": "", // The exit node name or IP address to use
      "exit_node_allow_lan_access": false, // Indicates whether locally accessible subnets should be routed directly or via the exit node
      "advertise_routes": [], // CIDR prefixes to advertise into the Tailscale network as reachable through the current node
      "advertise_exit_node": true, // Indicates whether the node should advertise itself as an exit node
      "advertise_tags": [], // Tags to advertise for this node, for ACL enforcement purposes
      "listen_port": 0, // The UDP port to listen on for WireGuard and peer-to-peer traffic, which is automatically selected by default
      "relay_server_port": 0, // The port to listen on for incoming relay connections from other Tailscale nodes
      "relay_server_static_endpoints": [], // Static endpoints to advertise for the relay server
      "system_interface": false, // Create a system TUN interface for Tailscale
      "system_interface_name": "", // Custom TUN interface name, default: tailscale
      "system_interface_mtu": 0, // Override the TUN MTU
      "udp_timeout": "5m", // UDP NAT expiration time
      "ssh_server": {
        "enabled": true,
        "disable_pty": false,
        "disable_sftp": false,
        "disable_forwarding": false
      }, // Run a Tailscale SSH server on tailnet port 22
      "taildrop_directory": "" // The directory where files received from tailnet peers are stored, default: Taildrop
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sing-tun0",
      "mtu": 9000,
      "address": [
        "172.18.0.1/30"
      ],
      "auto_route": true,
      "loopback_address": [
        "10.7.0.1"
      ],
      "strict_route": true,
      "route_address": [
        "0.0.0.0/1",
        "128.0.0.0/1"
      ],
      "route_exclude_address": [
        "192.168.0.0/16"
      ],
      "udp_timeout": "5m",
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "socks-out",
      "server": "YOUR_SOCKS5_SERVER_DOMAIN_OR_PUBLIC_IPV4",
      "server_port": YOUR_SOCKS5_SERVER_PORT,
      "username": "YOUR_SOCKS5_SERVER_USERNAME",
      "password": "YOUR_SOCKS5_SERVER_PASSWORD",
      "udp_over_tcp": false
    },
    // Equivalent to tag: "ts-ep"
    {
      "type": "direct",
      "tag": "direct-out"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct-out"
      },
      {
        "domain": [
          "YOUR_SOCKS5_SERVER_DOMAIN"
        ],
        "outbound": "direct-out"
      },
      // {
      //   "ip_cidr": [
      //     "YOUR_SOCKS5_SERVER_PUBLIC_IPV4/32"
      //   ],
      //   "outbound": "direct-out"
      // },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          }
        ],
        "action": "reject"
      }
    ],
    "final": "socks-out",
    "auto_detect_interface": true,
    "default_domain_resolver": "Cloudflare-DoH",
    "default_http_client": "rule-set-direct-out"
  },
  "services": [
    {
      "type": "api",
      "tag": "API",
      "listen": "127.0.0.1",
      "listen_port": 8081,
      "dashboard": {
        "enabled": true
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  }
}
