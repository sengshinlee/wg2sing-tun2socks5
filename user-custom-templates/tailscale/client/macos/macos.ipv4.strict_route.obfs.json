{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "DNSPod-V4",
        "server": "120.53.53.53",
        "tls": {
          "enabled": true,
          "server_name": "dns.pub"
        }
      },
      {
        "type": "https",
        "tag": "DNSPod-DoH",
        "domain_resolver": "DNSPod-V4",
        "server": "dns.pub"
      },
      {
        "type": "https",
        "tag": "Cloudflare-V4",
        "detour": "ts-ep",
        "server": "1.1.1.1",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        }
      },
      {
        "type": "https",
        "tag": "Cloudflare-DoH",
        "detour": "ts-ep",
        "domain_resolver": "Cloudflare-V4",
        "server": "cloudflare-dns.com"
      },
      {
        "type": "fakeip",
        "tag": "FakeIP",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": [
          "A"
        ],
        "server": "FakeIP"
      },
      {
        "rule_set": "geosite-geolocation-cn",
        "server": "DNSPod-DoH"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "Cloudflare-DoH"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          },
          {
            "rule_set": "geoip-cn",
            "match_response": true
          }
        ],
        "action": "respond"
      },
      {
        "rule_set": "geosite-anthropic",
        "server": "Cloudflare-DoH"
      }
    ],
    "final": "Cloudflare-DoH",
    "strategy": "ipv4_only",
    "disable_cache": true,
    "disable_expire": false
  },
  "ntp": {
    "server": "time.apple.com",
    "server_port": 0
  },
  "http_clients": [
    {
      "tag": "rule-set-direct-out",
      "engine": "apple"
    }
  ],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "state_directory": "",
      "auth_key": "",
      "control_url": "",
      "ephemeral": false,
      "hostname": "YOUR_MACOS_DEVICE_NAME",
      "accept_routes": false,
      "exit_node": "ubuntu-verizon-us-mob-socks5",
      "exit_node_allow_lan_access": true,
      "advertise_routes": [],
      "advertise_exit_node": false,
      "advertise_tags": [],
      "listen_port": 0,
      "system_interface": false,
      "system_interface_name": "",
      "system_interface_mtu": 0,
      "udp_timeout": "5m",
      "ssh_server": false,
      "taildrop_directory": ""
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "utun100",
      "mtu": 9000,
      "address": [
        "172.18.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "endpoint_independent_nat": false,
      "stack": "mixed"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "ip_is_private": true,
        "outbound": "direct-out"
      },
      {
        "process_name": [
          "WeChat",
          "Lark",

          "RustDesk",
          "Windows App",

          "Figma",
          "FigmaAgent",

          "BaiduNetdisk",
          "baiduNetdiskSync",
          "aDrive",

          "即刻",
          "小宇宙",
          "小红书",
          "哔哩哔哩"
        ],
        "outbound": "direct-out"
      },
      {
        "process_name": [
          "claude",
          "Claude"
        ],
        "outbound": "ts-ep"
      },
      {
        "domain": [
          "claude.ai",
          "www.claude.ai",
          "a.claude.ai",
          "assets.claude.ai",
          "console.claude.ai",
          "downloads.claude.ai",
          "preview.claude.ai",
          "sso.claude.ai",
          "staging.claude.ai",
          "status.claude.ai",

          "claude.com",
          "www.claude.com",

          "anthropic.com",
          "www.anthropic.com",
          "a-api.anthropic.com",
          "a-cdn.anthropic.com",
          "alignment.anthropic.com",
          "api.anthropic.com",
          "assets.anthropic.com",
          "console.anthropic.com",
          "docs.anthropic.com",
          "platform.anthropic.com",
          "privacy.anthropic.com",
          "red.anthropic.com",
          "statsig.anthropic.com",
          "status.anthropic.com",
          "support.anthropic.com",
          "trust.anthropic.com",
          "anthropic.cloudflareaccess.com",
          "claude-ai.staging.ant.dev"
        ],
        "outbound": "ts-ep"
      },
      {
        "domain_suffix": [
          "claude.ai",
          "claude.com",
          "anthropic.com"
        ],
        "outbound": "ts-ep"
      },
      {
        "rule_set": "geosite-geolocation-cn",
        "outbound": "direct-out"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "rule_set": "geoip-cn"
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "outbound": "direct-out"
      },
      {
        "rule_set": "geosite-anthropic",
        "outbound": "ts-ep"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-anthropic",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-anthropic.srs"
      }
    ],
    "final": "ts-ep",
    "auto_detect_interface": true,
    "default_domain_resolver": "DNSPod-DoH",
    "default_http_client": "rule-set-direct-out"
  },
  "experimental": {
    "cache_file": {
      "enabled": false,
      "store_dns": true,
      "store_fakeip": true
    }
  }
}
